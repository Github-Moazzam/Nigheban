# Nigehban -- development environment.
#
# Copy this to .env (already gitignored) and fill it in. Read by
# scripts/dev-tunnel.ps1 and scripts/dev-tunnel.sh. A variable already exported
# in your shell wins over anything set here, so a one-off override still works.

# The reserved ngrok domain, so the address you type into the phones never
# changes. Free ngrok accounts include one: dashboard.ngrok.com -> Domains.
# Leave it empty to get a random address that must be re-pasted every restart.
NIGEHBAN_NGROK_DOMAIN=

# ---- Supabase (Project Settings -> API) ------------------------------------
# URL: the project endpoint, e.g. https://abcdefg.supabase.co
SUPABASE_URL=

# Anon key: public, safe for the React Native app. Respects RLS policies.
SUPABASE_ANON_KEY=

# Service role key: SECRET. Bypasses RLS. Used by the server only.
# NEVER put this in the app or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection string (Settings -> Database -> Connection string).
# Used by the server when swapping SQLite for asyncpg/psycopg3.
# Example: postgresql://postgres:[PASSWORD]@db.abcdefg.supabase.co:5432/postgres
DATABASE_URL=
